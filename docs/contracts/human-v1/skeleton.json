  "additional_deform_bones": "forbidden in V1 animation skeleton; optional twist/corrective bones live in private deformation rig with explicit bake mapping",
  "bone_axis_rule": "Y=head_to_tail; Z=normalized projection of root-space +Y perpendicular to Y; if length<1e-6 use +Z projected instead; X=Y cross Z",
  "a_pose": {
    "arm_down_from_horizontal_degrees": 45,
    "elbow_extension": "straight",
    "knees": "straight",
    "palms": "+Y",
    "feet": "forward +Y, sole Z0",
    "fingers": "index/middle/ring/little straight parallel to hand; thumb45deg toward projected +Z from hand direction",
    "root_bone_head_m": [
      0,
      0,
      0
    ],
    "root_bone_tail_m": [
      0,
      0,
      0.1
    ]
  },
  "anchors": [
    {
      "key": "floor_contact",
      "bone": null,
      "datum": "asset root at floor projection of pelvis; identity frame"
    },
    {
      "key": "pelvis",
      "bone": "pelvis",
      "datum": "pelvis bone head; +Y front/+Z up"
    },
    {
      "key": "back_support",
      "bone": "spine_02",
      "datum": "posterior torso contact patch; +Y toward head/+Z outward posterior"
    },
    {
      "key": "hand_grip_l",
      "bone": "hand_l",
      "datum": "grip-cylinder center between palm and curled fingers; +Y transverse palm axis, +Z outward palm normal"
    },
    {
      "key": "foot_contact_l",
      "bone": "foot_l",
      "datum": "sole support center; +Y forward/+Z up"
    },
    {
      "key": "heel_contact_l",
      "bone": "foot_l",
      "datum": "heel sole contact; +Y forward/+Z up"
    },
    {
      "key": "toe_contact_l",
      "bone": "toe_l",
      "datum": "forefoot/toe sole contact; +Y forward/+Z up"
    },
    {
      "key": "hand_grip_r",
      "bone": "hand_r",
      "datum": "grip-cylinder center between palm and curled fingers; +Y transverse palm axis, +Z outward palm normal"
    },
    {
      "key": "foot_contact_r",
      "bone": "foot_r",
      "datum": "sole support center; +Y forward/+Z up"
    },
    {
      "key": "heel_contact_r",
      "bone": "foot_r",
